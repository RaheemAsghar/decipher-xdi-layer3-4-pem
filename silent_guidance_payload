silent_guidance_payload:
  guidance_id: "SG-<auto>"
  generated_at: "<ISO-8601>"
  version: "IME.SG.v2-STRICT"

  # Comes from the OU that is currently forming (your own runtime object)
  trigger_context:
    provisional_ou_id: "OU-<temp>"                # source: runtime/new OU
    experience_driver: "<Theme→Category→Subcategory→Entity>"  # source: runtime/new OU
    ed_id: "ED-<id>"                               # source: runtime/new OU
    emotion_group: "<...>"                         # source: runtime/new OU
    opportunity_stream: "<Fix|Optimize|Innovate|Amplify>"  # source: runtime/new OU
    interaction_moment: "<...>"                    # source: runtime/new OU
    cluster_preview:
      cluster_id: "CLU-<id>"                       # source: runtime/new OU (if any)
      label: "<...>"                               # source: runtime/new OU (if any)

  # Your recall query definition (safe meta, no free text)
  match_criteria:
    by_experience_driver: true
    by_emotion_group: true
    by_opportunity_stream: true
    by_interaction_moment: true
    window_days: 540
    min_similarity_score: 0.70

  # Computed only from counts/dates of retrieved precedents (no editorial text)
  match_summary:
    total_precedents_found: <int>                  # computed
    strict_matches: <int>                          # computed
    relaxed_matches: <int>                         # computed
    best_match_strength: <0.00-1.00>               # computed
    recurrence_stats:
      first_seen_at: "<YYYY-MM-DD>"                # min(ou.activation_date)
      last_activation_at: "<YYYY-MM-DD>"           # max(ou.activation_date)
      activations_in_window: <int>                 # count
      average_gap_days: <int>                      # computed
      recurrence_tier: "<High|Moderate|Low>"       # computed via your fixed thresholds
    filters_applied:                                # optional, machine-generated flags only
      - "<rule_tag_1>"
      - "<rule_tag_2>"

  # For EACH precedent: only copy from artifacts or compute deltas; never invent
  precedent_matches:
    - artifacts:
        signal_capsule_id: "SC-<id>"
        ou_payload_id: "OU-<id>"
        problem_statement_id: "PS-<id>"
        pdca_lifecycle_id: "PDCA-<id>"
        outcome_evaluation_id: "OE-<id>"
      snapshot:                                      # hydrated strictly from artifacts
        ou_core:
          ou_id: "<from:OU.id>"
          activation_date: "<from:OU.activation_date>"
          owner: "<from:OU.owner>"
          experience_driver: "<from:OU.experience_driver>"
          emotion_group: "<from:OU.emotion_group>"
          opportunity_stream: "<from:OU.opportunity_stream>"
          interaction_moment: "<from:OU.interaction_moment>"
          match_strength: <0.00-1.00>                # computed by your matcher
        outcomes_snapshot:
          disposition: "<from:OE.disposition>"       # e.g., Archived – Success
          emotional_shift:
            eri_pre: <from:OE.eri_pre>
            eri_post: <from:OE.eri_post>
            delta: <calc:eri_post - eri_pre>
          effort_score: <from:PDCA.metrics.effort_score | omit_if_missing>
          feasibility_score: <from:PDCA.metrics.feasibility_score | omit_if_missing>
        key_lessons:                                  # copy only; no paraphrase
          - "<from:OE.lessons[i] | PDCA.Check.findings[i]>"
      quick_nav:                                      # optional URI templates your UI resolves
        signal_capsule_uri: "/capsules/{signal_capsule_id}"
        ou_payload_uri: "/ous/{ou_payload_id}"
        problem_statement_uri: "/pdca/plan/{problem_statement_id}"
        pdca_lifecycle_uri: "/pdca/full/{pdca_lifecycle_id}"
        outcome_evaluation_uri: "/outcomes/{outcome_evaluation_id}"

  # Optional synthesis — but ONLY if fully traceable to cited lessons/findings
  strategic_guidance:
    synthesis_policy: "derive-only"                  # never introduce new facts
    used_sources:                                    # enumerate exact pointers used
      - "OE-<id>#lessons[...]" 
      - "PDCA-<id>#Check.findings[...]"
    recommendation_summary: "<synthesized_from: used_sources | omit_if_none>"
    caution_notes:
      - "<synthesized_from: used_sources | omit_if_none>"
    opportunity_alignment: "<computed_tag | omit_if_undefined>"
    confidence: <0.00-1.00 | omit_if_undefined>      # computed formula only (doc in code)

  retrieval_manifest:                                # for one-shot bulk fetch; IDs only
    artifact_ids:
      - "SC-<id>"
      - "OU-<id>"
      - "PS-<id>"
      - "PDCA-<id>"
      - "OE-<id>"
    endpoint_templates:
      signal_capsule: "/capsules/{id}"
      ou_payload: "/ous/{id}"
      problem_statement: "/pdca/plan/{id}"
      pdca_lifecycle: "/pdca/full/{id}"
      outcome_evaluation: "/outcomes/{id}"

  provenance:
    algorithm_version: "SG-recall.v1"
    guarantees:
      - "All non-ID values are copied from artifacts or deterministically computed."
      - "No free-text invented beyond optional, traced synthesis."
      - "Missing fields are omitted rather than fabricated."


