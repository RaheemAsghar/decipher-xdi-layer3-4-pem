                month_view = self._make_view_from_daily(daily_track, "month")
                if week_view:
                    views["week"] = week_view
                if month_view:
                    views["month"] = month_view
                # <<< END ADD
                
                # --- Provenance/meta (daily-aware) ---
                capsule_meta = {
                    "capsule_id": f"SC-{uuid4().hex[:12]}",
                    "window_start": str(full_idx[0].date()),
