# 🔧 Implementation
Here is a clean, minimal, ontology-safe implementation.

---

```python
class SEUSurface1Deterministic:
    """
    Surface 1A — Deterministic Structural Migration Engine
    V10-Pure. No invented metrics. No ML.
    """

    def evaluate(self, seu_snapshot: dict) -> dict:

        # ------------------------------
        # Eligibility Check
        # ------------------------------
        if not seu_snapshot.get("Temporal_Intelligence_Available", False):
            return {"surface1_available": False}

        if seu_snapshot.get("Observed_Days", 0) < 2:
            return {"surface1_available": False}

        # ------------------------------
        # Extract Required Fields
        # ------------------------------
        eri_flow = seu_snapshot.get("ERI_Flow", {})
        evi_flow = seu_snapshot.get("EVI_Flow", {})
        es_flow = seu_snapshot.get("ES_Flow", {})
        pattern_flow = seu_snapshot.get("Pattern_Flow", {})
        pem = seu_snapshot.get("PEM_Guidance", {})

        rf_tier = seu_snapshot.get("RF_Tier_Short")
        priority = seu_snapshot.get("Priority_Tier")

        # ------------------------------
        # Structural Direction
        # ------------------------------
        structural_direction = "Stable"

        if es_flow.get("changed"):
            if es_flow.get("end_band") > es_flow.get("start_band"):
                structural_direction = "Deteriorating"
            elif es_flow.get("end_band") < es_flow.get("start_band"):
                structural_direction = "Recovering"

        else:
            # If band unchanged, infer from ERI delta
            if eri_flow.get("delta", 0) < 0:
                structural_direction = "Soft Deterioration"
            elif eri_flow.get("delta", 0) > 0:
                structural_direction = "Soft Recovery"

        # ------------------------------
        # Deterioration Signal
        # ------------------------------
        deterioration_signal = None

        if (
            structural_direction in ["Deteriorating", "Soft Deterioration"]
            or pattern_flow.get("pattern_label") in ["Escalating", "Crisis"]
        ):
            deterioration_signal = "Active"

        # ------------------------------
        # Recovery Signal
        # ------------------------------
        recovery_signal = None

        if (
            structural_direction in ["Recovering", "Soft Recovery"]
            and pattern_flow.get("pattern_label") in ["Recovering", "Stabilizing"]
        ):
            recovery_signal = "Active"

        # ------------------------------
        # Volatility Signal
        # ------------------------------
        volatility_signal = None

        if evi_flow.get("tier_shift", 0) > 0:
            volatility_signal = "Escalating"

        elif evi_flow.get("tier_shift", 0) < 0:
            volatility_signal = "Consolidating"

        # ------------------------------
        # Urgency Pressure Signal
        # ------------------------------
        urgency_pressure_signal = None

        if rf_tier in ["Immediate", "High"]:
            urgency_pressure_signal = "Elevated"

        # ------------------------------
        # Crisis Proximity Signal
        # ------------------------------
        crisis_proximity_signal = None

        if seu_snapshot.get("Emotional_State_Band") in ["ES4", "ES5"]:
            crisis_proximity_signal = "In Crisis"

        elif pattern_flow.get("pattern_label") == "Escalating":
            crisis_proximity_signal = "Approaching"

        # ------------------------------
        # Advisory Bias
        # ------------------------------
        advisory_bias = pem.get("recommended_stream_bias")

        # ------------------------------
        # Confidence
        # ------------------------------
        confidence = (
            "High"
            if seu_snapshot.get("Observed_Days", 0) >= 3
            else "Limited"
        )

        return {
            "surface1_available": True,
            "structural_direction": structural_direction,
            "deterioration_signal": deterioration_signal,
            "recovery_signal": recovery_signal,
            "volatility_signal": volatility_signal,
            "urgency_pressure_signal": urgency_pressure_signal,
            "crisis_proximity_signal": crisis_proximity_signal,
            "advisory_bias": advisory_bias,
            "confidence": confidence
        }
```

