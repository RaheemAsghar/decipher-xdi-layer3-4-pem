
# ✅ Prompt (copy-paste for the model/annotator)

**Task:** From the customer review, produce **one record per Experience Driver (ED)**.
Keep everything extractable from the text; if you infer, include a brief justification tied to exact phrases. OU content is **preview-only**.

Return the **JSON** using the template below.

# 🧱 Output JSON template (Raw → CX Data)

```json
{
  "schema_version": "cx_dimensions.v1.0",
  "source": {
    "system": "reviews|surveys|chat|call|social",
    "record_id": "",
    "collected_at": "",
    "channel": "in-store|app|web|phone|email|social",
    "locale": "en-GB"
  },
  "customer_review": {
    "text": "",
    "text_hash": "",
    "attachments": []
  },
  "records": [
    {
      "experience_driver": {
        "theme": "",
        "category": "",
        "subcategory": "",
        "entity_name": ""
      },
      "context": "What the customer actually experienced, quoted/paraphrased from the text.",
      "keywords": ["word1","word2"],

      "feedback_type": "Complaint|Compliment|Suggestion|Request|Question|Product Usage Insight|Emerging Trend",

      "emotion": { "group": "", "specific": "" },

      "journey": {
        "customer_journey": "",
        "journey_stage": "",
        "interaction_moment": ""
      },

      "opportunity_stream_preview": {
        "stream": "Fix|Optimize|Innovate|Amplify",
        "innovation_sub_tier": 1,
        "justification": "Required if stream=Innovate; else null",
        "preview_only": true
      },

      "customer_effort_score": 1,

      "ou_draft_preview": {
        "ou_name": "[Entity Name] – [Feedback Type] – [Opportunity Stream]",
        "semantic_action_statement": {
          "section_1_customer_reality": "The customer provided a [Feedback Type] during [Interaction Moment] … [Context].",
          "section_2_strategic_response": "We need to [Opportunity Stream] → [Experience Driver] to address [MATTERS]."
        },
        "matters": "",
        "stream_justification": "",
        "matters_extraction": ["Voice","Context","Keywords","Interaction Moment"],
        "behavioral_impact": "",
        "preview_only": true
      },

      "evidence": {
        "text_spans": [[start,end]],
        "field_evidence": {
          "experience_driver": [[start,end]],
          "emotion": [[start,end]],
          "interaction_moment": [[start,end]]
        }
      }
    }
  ]
}
```

