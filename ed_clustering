# Convert to DataFrame for easier handling
df = pd.DataFrame(data)

# --- 2. Combine fields for embedding (Robust Combined Text) ---
# Emphasize Experience_Driver and Keywords by putting them first and joining Keywords
def combine_fields_for_embedding(row):
    keywords_str = " ".join(row["Keywords"]) if isinstance(row["Keywords"], list) else str(row["Keywords"])
    # Using f-string to combine, ensuring all parts are present
    combined_text = f"{row['Experience_Driver']} {keywords_str} {row['Context']} {row['Matters']}"
    return combined_text.strip() # Remove extra spaces at ends

df["Combined_Text"] = df.apply(combine_fields_for_embedding, axis=1)

# --- 3. Load pre-trained sentence transformer model ---
# Using a good all-around model for semantic similarity
model = SentenceTransformer('all-MiniLM-L6-v2') 

# --- 4. Generate embeddings ---
print("Generating embeddings for combined text...")
embeddings = model.encode(df["Combined_Text"].tolist(), show_progress_bar=True)
print("Embeddings generation complete.")

# --- 5. Cluster using DBSCAN with refined parameters ---
# To achieve "no fake clustering" (high similarity), we need a low 'eps'.
# Target cosine similarity >= 0.85 means eps <= 1 - 0.85 = 0.15
# min_samples=2: A cluster must have at least 2 points to form.
# This ensures that genuine "groups" are formed, not just isolated points.
print("\nPerforming DBSCAN clustering...")
DBSCAN_EPS = 0.15 # Max cosine distance (min 0.85 cosine similarity)
DBSCAN_MIN_SAMPLES = 2 # Minimum points to form a cluster
db = DBSCAN(eps=DBSCAN_EPS, min_samples=DBSCAN_MIN_SAMPLES, metric="cosine").fit(embeddings)
df["Cluster_ID"] = db.labels_
print(f"DBSCAN clustering complete. Found {len(set(df['Cluster_ID'])) - (1 if -1 in df['Cluster_ID'].unique() else 0)} clusters (excluding noise).")
