# --- 6. Generate Representative Driver Names (Human-in-the-Loop Prep) ---
# Instead of just the first, we'll suggest a canonical name based on the most frequent
# Experience_Driver, or the one closest to the cluster centroid.
# For simplicity here, we'll still use the first, but highlight the need for review.
# A more advanced approach would involve:
#   a) Finding the most central embedding in the cluster
#   b) Using a pre-defined taxonomy (if available) to classify the cluster
#   c) Human review and assignment
canonical_drivers = {}
for cluster_id in sorted(df["Cluster_ID"].unique()):
    if cluster_id == -1: # Noise points
        canonical_drivers[-1] = "Noise/Unclustered"
        continue
    
    group = df[df["Cluster_ID"] == cluster_id]
    
    if not group.empty:
        # Option 1: Most frequent Experience Driver in the cluster
        # most_frequent_driver = group["Experience_Driver"].mode()[0]
        # canonical_drivers[cluster_id] = most_frequent_driver

        # Option 2: Driver closest to the cluster's centroid (more robust for larger clusters)
        cluster_embeddings = embeddings[group.index]
        centroid = np.mean(cluster_embeddings, axis=0)
        similarities_to_centroid = cosine_similarity([centroid], cluster_embeddings)[0]
        most_representative_idx_in_cluster = np.argmax(similarities_to_centroid)
        most_representative_driver = group["Experience_Driver"].iloc[most_representative_idx_in_cluster]
        
        canonical_drivers[cluster_id] = most_representative_driver
    else:
        canonical_drivers[cluster_id] = "Unnamed Cluster" # Should not happen with current logic

df["Suggested_Canonical_Driver"] = df["Cluster_ID"].map(canonical_drivers)

# --- 7. Compute Cluster Cohesion (Confidence) ---
def compute_cluster_cohesion(cluster_id, embeddings_array, cluster_labels):
    if cluster_id == -1:  # Noise points have no cluster to cohere to
        return np.nan # Use NaN for noise, indicating not applicable
    
    cluster_indices = np.where(cluster_labels == cluster_id)[0]
    if len(cluster_indices) <= 1:
        # Single-item "clusters" (if min_samples=1 was used) have perfect cohesion by definition,
        # but for min_samples >= 2, this path implies an error or very small cluster.
        # For simplicity, if only one point, its cohesion is undefined in a 'group' sense.
        return np.nan 

    cluster_embeddings = embeddings_array[cluster_indices]
    
    # Calculate pairwise cosine similarities within the cluster
    pairwise_similarities = cosine_similarity(cluster_embeddings)
    
    # Exclude self-similarity (diagonal elements)
    np.fill_diagonal(pairwise_similarities, np.nan) 
    
    # Calculate the mean of upper triangle (to avoid duplicate pairs and self)
    # Filter out NaNs before calculating mean
    avg_similarity = np.nanmean(pairwise_similarities[np.triu_indices(len(cluster_indices), k=1)])
    
    return avg_similarity

df["Cluster_Cohesion"] = df["Cluster_ID"].apply(
    lambda x: compute_cluster_cohesion(x, embeddings, db.labels_)
)

# --- 8. Output Results ---
print("\n--- Clustered Experience Drivers Summary ---")
for cluster_id in sorted(df["Cluster_ID"].unique()):
