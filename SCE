# -------------------------------
# CONFIGURATION
# -------------------------------
SCAN_WINDOW_DAYS = 90
TODAY = datetime(2025, 8, 1)  # simulated current scan date

# -------------------------------
# MOCKED INSTITUTIONAL MEMORY STORE
# (Replace this with real records from your Decipher execution DB)
# -------------------------------
memory_store = [
    {
        'ou_id': 'OU-001',
        'experience_driver': 'Refund Status & Delays',
        'activation_date': datetime(2025, 1, 10),
        'signal_capsule': {...},
