***Complete PDCA Format Structure***

payload_meta:
  payload_id: "PDCA-{{uuid}}"
  payload_type: "pdca_execution_memory"
  payload_version: "PDCA.v1.0"
  generated_at: "{{timestamp_utc}}"
  mission_snapshot_id: "MS-{{bcs_group_id}}"
  lifecycle_stage: "layer_3_pdca_execution"
  institutional_memory_archive: true
  mission_window:
    start_date: "{{YYYY-MM-DD}}"
    target_completion: "{{YYYY-MM-DD}}"
    evaluation_trigger: "90_days_post_start"

mission_provenance:
  signal_capsule_id: "{{signal_capsule_id}}"
  ou_id: "{{ou_id}}"
  problem_statement_id: "{{problem_statement_id}}"
  bcs_group_id: "{{bcs_group_id}}"
  cluster_size: {{cluster_size}}
  cluster_cohesion: {{cluster_cohesion}}

pdca_cycle:
  orchestration_unit: "{{ou_name}}"

  # 🔍 PLAN PHASE – Root Cause Analysis
  problem_statement: >
    # Locked upstream narrative — do not edit

  five_whys:
    - Why 1: [Surface-level symptom or friction trigger]
    - Why 2: [Deeper behavioural or perceptual cause]
    - Why 3: [Systemic or contextual breakdown]
    - Why 4: [Structural, process, or ownership flaw]
    - Why 5 (Root Cause): [True foundational cause — actionable, addressable, and stream-aligned]

  cross_domain_validation:
    - domain: [Category Name]
      insight: [How this domain reveals additional context or interconnected factors]
    - domain: [Category Name]
      insight: [How this domain reveals additional context or interconnected factors]

  systemic_implications:
    - [Any broader organisational or process patterns identified]

  diagnostic_epiphany: >
    # A powerful, emotionally grounded synthesis that unites the customer’s lived reality 
    # (problem_statement) with the discovered root cause (Why 5). 
    # This is the decisive narrative that sets up all downstream action.
      
  # 🚀 DO PHASE – Initiative Generation
  initiatives:
    - name: "<Initiative Title>"
      description: "<What it does and why it matters>"
      stream: "{{opportunity_stream}}"
      innovation_score: <1–5>
      justification: "<Connects directly to diagnostic_epiphany + risk or inclusion insight>"
      pillar_attribution: "<Primary and secondary pillars used: e.g., RFE, CRE>"
      regulatory_alignment: "<Compliance frameworks addressed, if applicable>"
      risk_mitigation: "<How this mitigates fraud, abuse, or systemic risk>"
      hybrid_value_proposition: "<Customer emotional benefit + institutional value>"

    - name: "<Initiative Title>"
      description: "<What it does and why it matters>"
      stream: "{{opportunity_stream}}"
      innovation_score: <1–5>
      justification: "<Connects directly to diagnostic_epiphany + risk or inclusion insight>"
      pillar_attribution: "<Primary and secondary pillars used: e.g., RFE, CRE>"
      regulatory_alignment: "<Compliance frameworks addressed, if applicable>"
      risk_mitigation: "<How this mitigates fraud, abuse, or systemic risk>"
      hybrid_value_proposition: "<Customer emotional benefit + institutional value>"

    - name: "<Initiative Title>"
      description: "<What it does and why it matters>"
      stream: "{{opportunity_stream}}"
      innovation_score: <1–5>
      justification: "<Connects directly to diagnostic_epiphany + risk or inclusion insight>"
      pillar_attribution: "<Primary and secondary pillars used: e.g., RFE, CRE>"
      regulatory_alignment: "<Compliance frameworks addressed, if applicable>"
      risk_mitigation: "<How this mitigates fraud, abuse, or systemic risk>"
      hybrid_value_proposition: "<Customer emotional benefit + institutional value>"

  # 🧮 CHECK PHASE – Prioritization Matrix
  prioritization:
    - name: "{{initiative_name_1}}"
      impact: {{1–5}}
      feasibility: {{1–5}}
      alignment: {{1–5}}
      risk: {{1–5}}
      total_score: {{impact + feasibility + alignment - risk}}
      justification: >
        {{Prioritization logic: emotion, root cause fit, stream relevance, effort intensity, and owner readiness}}

    - name: "{{initiative_name_2}}"
      impact: {{1–5}}
      feasibility: {{1–5}}
      alignment: {{1–5}}
      risk: {{1–5}}
      total_score: {{impact + feasibility + alignment - risk}}
      justification: >
        {{Second initiative prioritization reasoning}}

    - name: "{{initiative_name_3}}"
      impact: {{1–5}}
      feasibility: {{1–5}}
      alignment: {{1–5}}
      risk: {{1–5}}
      total_score: {{impact + feasibility + alignment - risk}}
      justification: >
        {{Third initiative prioritization logic}}

  # 🎯 ACT PHASE – Business Outcomes & Commitment
  outcomes:
    - initiative: {{initiative_name_from_Do_phase}}
      strategic_pillars:
        - {{selected_strategic_pillar_1}}
        - {{selected_strategic_pillar_2}}
      outcome: >
        {{One-sentence statement of success that directly resolves the Plan Phase root cause and reflects the 
        Fix/Optimize/Innovate/Amplify intent. Must be observable in customer, operational, or business impact.}}
      metrics:
        - {{SMART_metric_1}}
        - {{SMART_metric_2}}
      explanation: >
        {{Explain how this initiative addresses the dominant emotion, root cause, and journey pain point — and why the 
        selected pillars and metrics are the best way to track and deliver value. Anchor it in real owner execution logic.}}

    - initiative: {{initiative_name_from_Do_phase}}
      strategic_pillars:
        - {{selected_strategic_pillar_1}}
        - {{selected_strategic_pillar_2}}
      outcome: >
        {{One-sentence statement of success that directly resolves the Plan Phase root cause and reflects the 
        Fix/Optimize/Innovate/Amplify intent. Must be observable in customer, operational, or business impact.}}
      metrics:
        - {{SMART_metric_1}}
        - {{SMART_metric_2}}
      explanation: >
        {{Explain how this initiative addresses the dominant emotion, root cause, and journey pain point — and why the 
        selected pillars and metrics are the best way to track and deliver value. Anchor it in real owner execution logic.}}

    - initiative: {{initiative_name_from_Do_phase}}
      strategic_pillars:
        - {{selected_strategic_pillar_1}}
        - {{selected_strategic_pillar_2}}
      outcome: >
        {{One-sentence statement of success that directly resolves the Plan Phase root cause and reflects the 
        Fix/Optimize/Innovate/Amplify intent. Must be observable in customer, operational, or business impact.}}
      metrics:
        - {{SMART_metric_1}}
        - {{SMART_metric_2}}
      explanation: >
        {{Explain how this initiative addresses the dominant emotion, root cause, and journey pain point — and why the 
        selected pillars and metrics are the best way to track and deliver value. Anchor it in real owner execution logic.}}

OU_lifecycle_layer_3_completion:
  pdca_status: "Committed"
  institutional_archive: true
  next_milestone: "30-day checkpoint"
  handoff_readiness: "Ready for outcome evaluation"

